# ── Stage 1: build ────────────────────────────────────────────────────────────
# Full Node image to run Vite. Used to compile the frontend, then thrown away —
# same pattern as the backend Dockerfile's Maven stage.
FROM node:22-alpine AS build

WORKDIR /app

# Copy the dependency manifests first. As long as package.json/package-lock.json
# don't change, the `npm ci` layer is cached and rebuilds skip the download.
# `npm ci` (not `npm install`) installs exactly what the lockfile says — the
# reproducible-build variant for CI.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Now copy source and build. Output lands in /app/dist.
COPY frontend/ ./
RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
# nginx with the built assets and its config baked IN — no bind mounts, so the
# deployed frontend is a single immutable, versioned artifact pulled from GHCR,
# exactly like the backend jar image. This is what lets a fresh `terraform
# apply` come up with the real frontend instead of a placeholder page.
FROM nginx:1.27-alpine

COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
