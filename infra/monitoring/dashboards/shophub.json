      "type": "timeseries",
      "title": "Non-heap used",
      "description": "Metaspace, code cache, thread stacks. Counts against the container memory limit even though it is not heap.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
