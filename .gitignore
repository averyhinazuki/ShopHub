### Only push src, frontend, pom.xml, README ###
# jmeter/ test plans + setup.py ARE tracked so the load test migrates; only its
# generated artifacts are ignored (tokens.csv, *.jtl, *.log — covered by rules below)
tokens.csv

# Personal interview-prep artifacts — keep out of the public repo
INTERVIEW_PREP.html
INTERVIEW_PREP.md
render_interview.py

# OS
.DS_Store
images/
description.txt
resume.html
*.jtl
*.log
postman/
# docs/ stays untracked EXCEPT docs/study/ — the study notes and the findings
# list are worth version history. `docs/*` rather than `docs/` is load-bearing:
# git never descends into an excluded *directory*, so a bare `docs/` would make
# the `!docs/study/` re-include unreachable.
docs/*
!docs/study/
.mvn/
jmeter.log
mvnw
CLAUDE.md
flash-sale-blueprint.md
generate_tokens.py
mvnw.cmd
PROGRESS.md
README1.md
.gitignore
.gitattributes
TECH_OVERVIEW.txt

### Terraform ###
# State files contain resource attributes (including secrets passed as
# variables, e.g. mysql_root_password) in plaintext — never commit them.
# Globbed rather than pinned to infra/terraform/ because there is now more
# than one Terraform root: the app stack, and infra/terraform/persistent/
# (the data volume, kept in its own state so `destroy` can't reach it).
**/.terraform/
**/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
**/*.tfplan
infra/terraform/crash.log
# Real tfvars has real secrets in it; only terraform.tfvars.example is tracked.
infra/terraform/terraform.tfvars
infra/terraform/*.auto.tfvars
# Guard against terraform accidentally run outside infra/terraform (it drops
# state wherever it runs) — ignore state files anywhere in the repo.
*.tfstate
*.tfstate.*

